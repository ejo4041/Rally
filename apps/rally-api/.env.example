# Put secrets in the shared ignored root .env.local, or an external file.
# RALLY_ENV_FILE=/absolute/path/to/shared/.env.local
RALLY_PAID_ENABLED=0
MODEL_API_KEY=
RALLY_DEMO_PASSWORD=
PORT=3001
LIVEKIT_PORT=7880
RALLY_DB_PATH=.data/rally.sqlite
RALLY_ASSESSMENT_MS=10000
RALLY_COOLDOWN_MS=60000
RALLY_MEETING_BUDGET=2
RALLY_BUILD_BUDGET=5

# Optional existing Teams transcription-test bridge. Server-side only.
RALLY_TEAMS_SITE_URL=
RALLY_SITES_SERVICE_TOKEN=

# Shared AWS speech. Keep the token outside tracked files.
RALLY_SPEECH_ADAPTER=seamless-aws
RALLY_TTS_TOKEN=
RALLY_TTS_CONCURRENCY=1
RALLY_TEAMS_LIVE_ENABLED=0
RALLY_CAPTURE_LEASE_MS=90000
LIVEKIT_PUBLIC_URL=

# Persistent private 32-byte random hex key; generate securely and keep out of Git.
RALLY_MFA_KEY=

# Continuous partial-transcript checks. Enable after validation.
RALLY_REALTIME_ENABLED=0
# Preserve this amount of the existing budget for final analysis (USD).
RALLY_REPORT_RESERVE=0.25
# Enable only for a consented Teams overlap/echo pilot.
RALLY_TEAMS_DUPLEX_ENABLED=0
