{
  "name": "rally-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "start": "node src/server.ts",
    "seed": "node scripts/seed.ts",
    "setup:media": "node scripts/setup-media.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:media": "node scripts/media-smoke.ts",
    "test:muse": "node scripts/muse-smoke.ts"
  },
  "dependencies": {
    "@livekit/rtc-node": "1.2.1",
    "express": "5.3.0",
    "livekit-server-sdk": "2.19.2",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "livekit-client": "2.23.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  }
}
