[Unit]
Description=Rally Teams meeting browser runner
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/hackathon/repo/experiments/teams-audio
ExecStart=/srv/hackathon/tools/node/bin/node runner.mjs
Environment=LD_LIBRARY_PATH=/srv/hackathon/tools/browser-libs
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group

[Install]
WantedBy=default.target
