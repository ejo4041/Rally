[Unit]
Description=Rally Teams meeting presence
After=network-online.target
Conflicts=rally-teams-web-runner.service
[Service]
Type=simple
WorkingDirectory=/srv/hackathon/rally-deployed/current/experiments/teams-presence
EnvironmentFile=/srv/hackathon/rally-deployed/config/presence.env
Environment=PATH=/srv/hackathon/tools/node/bin:/usr/local/bin:/usr/bin:/bin
Environment=LD_LIBRARY_PATH=/srv/hackathon/tools/browser-libs
ExecStart=/srv/hackathon/tools/node/bin/node runner.mjs
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
KillMode=control-group
UMask=0077
[Install]
WantedBy=default.target
