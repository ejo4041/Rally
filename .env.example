# Local full application. Public simulation needs none of these settings.
# Run node scripts/init-local.mjs to generate a private .env.local with an MFA key.
MODEL_API_KEY=
RALLY_MFA_KEY=GENERATE_WITH_INIT_LOCAL
RALLY_PAID_ENABLED=0
RALLY_REALTIME_ENABLED=0
RALLY_MEETING_BUDGET=2
RALLY_BUILD_BUDGET=5
RALLY_HOST=127.0.0.1
PORT=3001
RALLY_WEB_PORT=5173
RALLY_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
RALLY_SECURE_COOKIES=0
# Teams guest joining and speech require extra Linux media/model provisioning.
RALLY_TEAMS_DUPLEX_ENABLED=0
RALLY_MMS_ENABLED=0
# No Azure ACS connection string, Azure app registration or hosted-site token
# is needed for local browser microphone/tab capture or the Teams guest route.
