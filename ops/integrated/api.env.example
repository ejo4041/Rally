# Runtime secret file outside the release/repo; chmod 600.
MODEL_API_KEY=
RALLY_ENV_FILE=/dev/null
RALLY_HOST=127.0.0.1
PORT=3301
RALLY_DB_PATH=/srv/hackathon/rally-deployed/state/rally.sqlite
RALLY_ALLOWED_ORIGINS=https://rally.tail703f9e.ts.net:8445
RALLY_SECURE_COOKIES=1
RALLY_PAID_ENABLED=1
RALLY_MEETING_BUDGET=2
RALLY_BUILD_BUDGET=5
LIVEKIT_URL=wss://rally.tail703f9e.ts.net:8446
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Existing protected Teams queue; never expose this token to the browser.
RALLY_TEAMS_SITE_URL=https://rally-meeting-moderator.excavator3496.chatgpt.site
RALLY_SITES_SERVICE_TOKEN=

# Optional offline Meta MMS voice; provision the pinned weights/Python first.
RALLY_MMS_ENABLED=0
RALLY_MMS_PYTHON=/srv/hackathon/tools/mms-venv/bin/python
RALLY_MMS_MODEL_DIR=/srv/hackathon/models/mms-tts-eng

# Planned ASR handoff; default 55 minutes, below the documented Muse cap.
RALLY_ASR_ROTATION_MS=3300000

# Public HTTPS ingress uses a separate browser URL from local backend signaling.
LIVEKIT_PUBLIC_URL=wss://rally.tail703f9e.ts.net/livekit
RALLY_CAPTURE_LEASE_MS=90000
# Explicit selection; no automatic provider fallback or retries.
RALLY_SPEECH_ADAPTER=seamless-aws
RALLY_TTS_TOKEN=
RALLY_TTS_CONCURRENCY=1
# Enable only with the legacy Sites Teams queue consumer stopped.
RALLY_TEAMS_LIVE_ENABLED=0
# Required by the provisioned Chromium binary on this deployment host.
LD_LIBRARY_PATH=/srv/hackathon/tools/browser-libs
XDG_RUNTIME_DIR=/run/user/1000

# Persistent private random 32-byte hex key, outside Git.
RALLY_MFA_KEY=

# Continuous partial-transcript checks. Enable after validation.
RALLY_REALTIME_ENABLED=0
# Preserve this amount of the existing budget for final analysis (USD).
RALLY_REPORT_RESERVE=0.25
# Enable only for a consented Teams overlap/echo pilot.
RALLY_TEAMS_DUPLEX_ENABLED=0

# Canonical TeamsLive camera; requires tested /dev/video42 producer.
RALLY_PRESENCE_VIDEO_ENABLED=0
RALLY_PRESENCE_ORIGIN=https://rally.tail703f9e.ts.net:8445
RALLY_TEAMS_LOCK=/srv/hackathon/rally-deployed/state/teams.lock
